{
  "name": "african-nomad-qbd-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "SOAP service for QuickBooks Web Connector — syncs approved job sheets from Supabase into QuickBooks Desktop as Estimates via qbXML",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "qwc": "node scripts/generate-qwc.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
