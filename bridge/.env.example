# Supabase — same project as the Job Sheet app (wnsjzxotknadqvznnijw).
# The bridge uses the SERVICE ROLE key (not the anon key) because it must
# write sync results back to qbd_sync_queue, which is read-only for anon.
# Get it from: Supabase dashboard -> Project Settings -> API -> service_role.
SUPABASE_URL=https://wnsjzxotknadqvznnijw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Credentials QuickBooks Web Connector will use to authenticate against this
# bridge. Pick anything strong; they go in the QBWC password prompt when you
# add the .qwc file (username lives inside the .qwc itself).
QBWC_USERNAME=an-jobsheets
QBWC_PASSWORD=

# QuickBooks item/account names used when building transactions.
# The bridge auto-creates missing service items on first sync.
QBD_ITEM_NAME=Job Sheet Line
QBD_VAT_MODE=line
QBD_VAT_ITEM_NAME=VAT @ 15%
QBD_INCOME_ACCOUNT=Sales
QBD_EXPENSE_ACCOUNT=Job Expenses

PORT=8080
