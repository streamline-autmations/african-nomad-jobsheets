# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# values. Anything prefixed VITE_ is inlined into the browser bundle at build
# time and is therefore public; everything else is server-side only.

# --- Supabase (browser client) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# --- NSA-branded document letterhead ---
# Rendered onto the client-facing Quote/Invoice documents. These are a third
# party's real business details, so they live here rather than in source.
# Address lines are pipe-separated, one document line per segment.
VITE_NSA_COMPANY_NAME=Example Trading (Pty) Ltd
VITE_NSA_ADDRESS_LINES=1 Example Street|Example Suburb, Example City|0000
VITE_NSA_VAT_NUMBER=0000000000
VITE_NSA_EMAIL=accounts@example.com
VITE_NSA_PHONE=+27 00 000 0000
# Banking block — shown on Invoices only. Leave VITE_NSA_BANK_NAME empty to
# suppress the whole block.
VITE_NSA_BANK_NAME=Example Bank
VITE_NSA_BANK_ACCOUNT_TYPE=Current Account
VITE_NSA_BANK_ACCOUNT_NUMBER=0000000000
VITE_NSA_BANK_BRANCH_CODE=000000

# --- QuickBooks Online OAuth (api/qbo/* serverless functions) ---
# Client ID/Secret come from the Intuit Developer Portal > your app >
# Keys & OAuth. Use the Sandbox keys/company while testing; switch to
# Production keys only once a real company is ready to authorize.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Must exactly match a Redirect URI registered in the Intuit app's
# Keys & OAuth tab.
QBO_REDIRECT_URI=http://localhost:3000/api/qbo/callback
# Selects which Intuit API host api/_lib/qboApi.ts calls. Anything other than
# "production" targets the sandbox.
QBO_API_ENVIRONMENT=sandbox

# --- Supabase (server-side, api/qbo/*) ---
# Service-role key so the serverless functions can read/write qbo_connections
# directly. Bypasses RLS — never expose this to the browser and never give it
# a VITE_ prefix. Supabase dashboard > Project Settings > API > service_role.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
