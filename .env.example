VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# --- QuickBooks Online OAuth (api/qbo/* serverless functions) ---
# Get Client ID/Secret from the Intuit Developer Portal > your app > Keys & OAuth.
# Start against the Sandbox keys/company while testing; switch to Production
# keys only once NSA is ready to actually authorize a connection.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Must exactly match a Redirect URI registered in the Intuit app's Keys & OAuth tab.
QBO_REDIRECT_URI=http://localhost:3000/api/qbo/callback

# Service-role key for api/qbo/* to read/write qbo_connections directly
# (bypasses RLS — never expose this to the browser). Same project as
# VITE_SUPABASE_URL above. Get it from: Supabase dashboard > Project
# Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=
